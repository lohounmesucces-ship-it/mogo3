// Send the stop/delete to NOI via REST API (PATCH if active, DELETE if future)
var status int
var response string
if startDate.Before(time.Now()) {
    status, response, err = patchMaintenanceOnNOI(critID)
} else {
    status, response, err = deleteMaintenanceFromNOI(critID)
}
