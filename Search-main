// Delete a maintenance window from NOI via the REST API
func deleteMaintenanceFromNOI(mwid string) (int, string, error) {

    baseURL := sysdigLibrary.ReadEnv(sysdigLibrary.BASEDIR, "NOI_API_URL")
    path := sysdigLibrary.ReadEnv(sysdigLibrary.BASEDIR, "NOI_API_MAINTENANCE_PATH")

    url := baseURL + path + "?mwid=" + mwid

    tokenCmd := exec.Command(sysdigLibrary.BASEDIR+"/netcool_get_oauth2_token", "-m")
    out, err := tokenCmd.CombinedOutput()
    if err != nil {
        return 0, "", err
    }
    token := strings.TrimSpace(string(out))

    req, err := http.NewRequest("DELETE", url, nil)
    if err != nil {
        return 0, "", err
    }

    req.Header.Set("Authorization", "Bearer "+token)
    req.Header.Set("Content-Type", "application/json")

    client := &http.Client{Timeout: 30 * time.Second}

    resp, err := client.Do(req)
    if err != nil {
        return 0, "", err
    }
    defer resp.Body.Close()

    b, _ := ioutil.ReadAll(resp.Body)

    sysdigLibrary.Trace("INFO", "NOI DELETE URL="+url)
    sysdigLibrary.Trace("INFO", "NOI DELETE STATUS="+strconv.Itoa(resp.StatusCode))
    sysdigLibrary.Trace("INFO", "NOI DELETE RESPONSE="+string(b))

    if resp.StatusCode != 200 && resp.StatusCode != 204 {
        return resp.StatusCode, string(b), errors.New("NOI API delete failed")
    }

    return resp.StatusCode, string(b), nil
}
